# Copy to .env and replace every placeholder. Never commit real secrets.
DATALINEAGE_ENVIRONMENT=production
DATALINEAGE_AUTH_ENABLED=true
DATALINEAGE_AUTH_USERNAME=admin
DATALINEAGE_AUTH_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
DATALINEAGE_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
DATALINEAGE_SECURE_COOKIE=true
DATALINEAGE_PUBLIC_BASE_URL=https://your-domain.example
DATALINEAGE_CORS_ORIGINS=https://your-domain.example
DATALINEAGE_EMAIL_DEV_MODE=false
DATALINEAGE_SMTP_HOST=smtp.your-provider.example
DATALINEAGE_SMTP_PORT=465
DATALINEAGE_SMTP_FROM_EMAIL=noreply@your-domain.example
DATALINEAGE_SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
DATALINEAGE_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
DATALINEAGE_SMTP_SSL=true
DATALINEAGE_SMTP_STARTTLS=false

# Set only when the corresponding infrastructure is actually configured.
# DATALINEAGE_SECRET_MANAGER_CONFIGURED=1
# DATALINEAGE_TLS_ENFORCED=1

# Keep persistent data on a durable volume; these paths are container paths.
DATALINEAGE_DB_PATH=/app/backend/data/analysis_runs.sqlite3
DATALINEAGE_USERS_DB_PATH=/app/backend/data/users.sqlite3
DATALINEAGE_SAAS_DB_PATH=/app/backend/data/saas.sqlite3
DATALINEAGE_SECURITY_DB=/app/backend/data/security.sqlite3

# PostgreSQL adapter: configure only after creating a dedicated database/user and testing a restore.
# Important: not every application store has been migrated off SQLite; keep one API replica.
# For Docker Compose profile `postgres`, use host `postgres` in the DSN.
# DATALINEAGE_DATABASE_URL=postgresql://datalineage:REPLACE_WITH_PASSWORD@postgres:5432/datalineage
# M63 service-gate override. Use true when this staging deployment requires PostgreSQL.
DATALINEAGE_POSTGRES_REQUIRED=false
# Optional local Compose PostgreSQL service (do not reuse these sample values in production)
# POSTGRES_DB=datalineage
# POSTGRES_USER=datalineage
# POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD

# M49 shared rate limiting and M50 durable queue.
# For Docker Compose profile `redis`, use redis://redis:6379/0.
# DATALINEAGE_REDIS_URL=redis://redis:6379/0
# Set true only when Redis is deliberately required; M63 probes it with PING.
DATALINEAGE_REDIS_REQUIRED=false
